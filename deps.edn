{:paths ["src" "resources"]

 :deps
 {
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
  hiccup/hiccup {:mvn/version "2.0.0"}
  org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
  ring/ring-core {:mvn/version "1.15.5"}
  ring/ring-jetty-adapter {:mvn/version "1.15.5"}
  org.slf4j/slf4j-simple {:mvn/version "2.0.18"}}

 :aliases
 {
  ;; uberjar build via tools.build (clojure -T:build uber)
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}

  ;; run the application (clojure -M:run)
  :run {:jvm-opts  ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["--main" "estoualer.main"]}

  ;; run the application with hotreload enabled (clojure -M:hotreload)
  :hotreload {:extra-paths ["dev"]
              :extra-deps  {ring/ring-devel {:mvn/version "1.15.5"}}
              :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
              :main-opts   ["--main" "hotreload"]}

  ;; start conjure repl
  :repl/conjure {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                              cider/cider-nrepl {:mvn/version "0.62.2"}}
                 :main-opts  ["--main" "nrepl.cmdline"
                              "--middleware" "[cider.nrepl/cider-middleware]"
                              "--interactive"]}}}
